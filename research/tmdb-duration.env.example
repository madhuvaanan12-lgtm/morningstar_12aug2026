# Configure these as Netlify environment variables. Do not commit real values.
# Bearer token is preferred; API key is supported as a fallback.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Total TMDB API requests allowed per build. Each matched title normally uses
# two requests: /find/{IMDb ID} + /tv/{TMDB ID}. Default in code is 1200.
TMDB_MAX_REQUESTS=1200
